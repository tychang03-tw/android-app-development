<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/InL1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btnM"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:text="長按關閉購物車"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.814"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <CheckBox
        android:id="@+id/chk1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="13dp"
        android:text="鬼滅之刃吊飾 NTD 150"
        app:layout_constraintEnd_toStartOf="@+id/btnM"
        app:layout_constraintTop_toBottomOf="@+id/btnM" />

    <CheckBox
        android:id="@+id/chk2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:text="海盜王筆記本 NTD 230"
        app:layout_constraintStart_toStartOf="@+id/btnM"
        app:layout_constraintTop_toBottomOf="@+id/btnM" />

    <CheckBox
        android:id="@+id/chk3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="1dp"
        android:text="火影忍者公仔 NTD 510"
        app:layout_constraintEnd_toEndOf="@+id/chk1"
        app:layout_constraintTop_toBottomOf="@+id/chk1" />

    <CheckBox
        android:id="@+id/chk4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="機器人 NTD 620"
        app:layout_constraintStart_toStartOf="@+id/chk2"
        app:layout_constraintTop_toBottomOf="@+id/chk2" />

    <Button
        android:id="@+id/btn0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="34dp"
        android:text="訂購"
        app:layout_constraintStart_toEndOf="@+id/chk3"
        app:layout_constraintTop_toBottomOf="@+id/chk4" />

    <TextView
        android:id="@+id/txvS"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="57dp"
        android:layout_marginTop="30dp"
        android:text="購物車是空的"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn0" />

    <TextView
        android:id="@+id/txvNT"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginBottom="68dp"
        android:text="總金額 : NTD  0"
        app:layout_constraintBottom_toTopOf="@+id/currency"
        app:layout_constraintStart_toStartOf="parent" />

    <RadioGroup
        android:id="@+id/currency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.78">

        <RadioButton
            android:id="@+id/rNtd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="新台幣" />

        <RadioButton
            android:id="@+id/rUsd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="美元" />

        <RadioButton
            android:id="@+id/rKrw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="韓元" />
    </RadioGroup>

    <TextView
        android:id="@+id/txvC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="76dp"
        android:layout_marginTop="90dp"
        android:layout_marginBottom="89dp"
        android:text="付款金額 :  NTD"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/currency"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/txvM"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="43dp"
        android:layout_marginEnd="53dp"
        android:text="0"
        app:layout_constraintEnd_toEndOf="@+id/currency"
        app:layout_constraintTop_toBottomOf="@+id/currency" />

</androidx.constraintlayout.widget.ConstraintLayout>